resource "conductorone_request_schema" "my_request_schema" {
  name        = "Site access request"
  description = "Collect the site URL for an access request."

  fields = [{
    display_name = "Site URL"
    required     = true
    # The nested field name is generated by the server; do not configure it.
    string_field = {
      placeholder = "https://example.com"
      rules       = { uri_ref = true }
      # Configure exactly one view. Empty objects and false values count as present.
      text_field = { multiline = false }
    }
  }]
}
