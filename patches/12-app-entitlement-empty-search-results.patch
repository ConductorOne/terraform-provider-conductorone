Subject: [PATCH] Allow empty app entitlement search results

The singular conductorone_app_entitlement data source treats an empty search
result as an API error ("Missing response body array data."), so a lookup fails
whenever the search index lags a create or the filter has no matches. Return
zero results instead: entity attributes stay null, next_page_token is still
set, and the facet count survives (exposed as result_count by
patches/08-app-entitlement-result-count.patch).

diff --git a/internal/provider/app_entitlement_data_source_sdk.go b/internal/provider/app_entitlement_data_source_sdk.go
index 69fa4792..7a3dbe0d 100644
--- a/internal/provider/app_entitlement_data_source_sdk.go
+++ b/internal/provider/app_entitlement_data_source_sdk.go
@@ -552,15 +552,12 @@ func (r *AppEntitlementDataSourceModel) RefreshFromSharedAppEntitlementSearchSer
 		if resp.Facets != nil {
 			r.Count = types.StringPointerValue(resp.Facets.Count)
 		}
-		if len(resp.List) == 0 {
-			diags.AddError("Unexpected response from API", "Missing response body array data.")
-			return diags
-		}
-
-		diags.Append(r.RefreshFromSharedAppEntitlementView(ctx, &resp.List[0])...)
+		if len(resp.List) > 0 {
+			diags.Append(r.RefreshFromSharedAppEntitlementView(ctx, &resp.List[0])...)
 
-		if diags.HasError() {
-			return diags
+			if diags.HasError() {
+				return diags
+			}
 		}
 
 		r.NextPageToken = types.StringPointerValue(resp.NextPageToken)
