Subject: [PATCH] Restore BoolNull fallbacks for flattened permissions

Speakeasy omits the else branch for nullable ObjectPermissions blocks, leaving flattened Terraform booleans Unknown when the API omits the object. Set the fields to Null explicitly; the manually-managed AppResource response needs the same treatment.

diff --git a/internal/provider/access_review_data_source_sdk.go b/internal/provider/access_review_data_source_sdk.go
index d287a64b..ba23cfcc 100644
--- a/internal/provider/access_review_data_source_sdk.go
+++ b/internal/provider/access_review_data_source_sdk.go
@@ -605,6 +605,11 @@ func (r *AccessReviewDataSourceModel) RefreshFromSharedAccessReviewView(ctx cont
 				}
 			}
 			r.Read = types.BoolPointerValue(resp.ObjectPermissions.Read)
+		} else {
+			r.Delete = types.BoolNull()
+			r.Edit = types.BoolNull()
+			r.Extra = nil
+			r.Read = types.BoolNull()
 		}
 		r.PolicyPath = types.StringPointerValue(resp.PolicyPath)
 	}
